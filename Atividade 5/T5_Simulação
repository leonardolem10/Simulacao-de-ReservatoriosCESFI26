def plotar_campos(campos, G, titulo, rotulo, cmap, vmin, vmax, inj_pos=(), prod_pos=()):
    fig, axs = plt.subplots(2, 2, figsize=(11.5, 9.8), sharex=True, sharey=True)
    axs = axs.ravel()
    aspecto = "equal" if abs(G.Lx - G.Ly) < 1e-9 else "auto"

    for ax, (t_d, campo) in zip(axs, campos.items()):
        im = ax.imshow(
            campo, extent=[0, G.Lx, 0, G.Ly], origin="lower",
            cmap=cmap, vmin=vmin, vmax=vmax, aspect=aspecto
        )
        for ii, jj in inj_pos:
            ax.plot(G.x_c[jj], G.y_c[ii], "^", color="#49006a", markersize=8, markeredgecolor="w", zorder=5)
        for iw, jw in prod_pos:
            ax.plot(G.x_c[jw], G.y_c[iw], "kD", markersize=7, markeredgecolor="w", zorder=6)

        ax.set_title(f"t = {t_d:.2f} dias", fontsize=11, pad=10)
        ax.set_xlabel("X [m]")
        ax.set_ylabel("Y [m]")
        ax.set_xlim(0, G.Lx)
        ax.set_ylim(0, G.Ly)

    fig.subplots_adjust(left=0.08, right=0.84, bottom=0.08, top=0.88, wspace=0.05, hspace=0.25)
    cbar_ax = fig.add_axes([0.87, 0.12, 0.025, 0.75])
    fig.colorbar(im, cax=cbar_ax, label=rotulo)
    fig.suptitle(titulo, fontsize=13, y=0.96)
    salvar_e_fechar()

def plotar_desempenho(sim, titulo, t_bt=None):
    t = sim["tempo"]
    fig, ax_q = plt.subplots(figsize=(6.5, 4))
    ax_q.plot(t[1:], np.full(len(t) - 1, sim["q_inj"] * DIA), color="#49006a", linestyle="--", linewidth=2, label="Vazão Injetada")
    ax_q.plot(t[1:], sim["q_o"][1:] * DIA, color="#980043", linestyle="-", linewidth=2, label="Vazão de Óleo")
    ax_q.plot(t[1:], sim["q_w"][1:] * DIA, color="#df65b0", linestyle="-", linewidth=2, label="Vazão de Água")
    if t_bt is not None:
        ax_q.axvline(t_bt, color="gray", linestyle="-.", linewidth=1.5, label="Breakthrough (analítico)")
    ax_q.set_xlabel("Tempo [dias]")
    ax_q.set_ylabel("Vazão [m³/dia]")
    ax_q.grid(True, linestyle="--", alpha=0.5)

    ax_q_twin = ax_q.twinx()
    ax_q_twin.plot(t, np.concatenate([[0.0], sim["Np"][1:]]), color="#7a0177", linestyle=":", linewidth=2, label="Np (óleo acumulado)")
    ax_q_twin.plot(t, np.concatenate([[0.0], sim["Wp"][1:]]), color="#f768a1", linestyle=":", linewidth=2, label="Wp (água acumulada)")
    ax_q_twin.set_ylabel("Produção acumulada [m³]", color="#7a0177")

    h1, l1 = ax_q.get_legend_handles_labels()
    h2, l2 = ax_q_twin.get_legend_handles_labels()
    ax_q.legend(h1 + h2, l1 + l2, loc="center left", fontsize=8)
    plt.title(titulo, fontsize=11)
    plt.tight_layout()
    salvar_e_fechar()

def plotar_perfis(G, sim, rp, uT, solucao, titulo):
    """Compara Sw(x) numérica (linha central) x analítica para os tempos salvos."""
    campos = sim["campos_S"]
    cores = plt.cm.PuRd(np.linspace(0.45, 0.95, len(campos)))
    plt.figure(figsize=(6.5, 4))
    erros = []
    for cor, (t_d, S_campo) in zip(cores, campos.items()):
        S_an, _, _ = solucao(G.x_c, t_d * DIA, uT, rp)
        S_num = S_campo[G.ny // 2, :]
        erros.append(np.mean(np.abs(S_num - S_an)))
        plt.plot(G.x_c, S_an, '-', color=cor, linewidth=2, label=f"t = {t_d:.1f} dias")
        plt.plot(G.x_c, S_num, 'o', color=cor, markersize=3)
    plt.plot([], [], color="#980043", linestyle="-", linewidth=2, label="Analítica")
    plt.plot([], [], color="#980043", marker="o", linestyle="None", markersize=4, label="Numérica (IMPES)")
    plt.title(titulo, fontsize=11)
    plt.xlabel("X [m]")
    plt.ylabel("Saturação de água Sw")
    plt.grid(True, linestyle="--", alpha=0.5)
    plt.legend(fontsize=8)
    plt.tight_layout()
    salvar_e_fechar()
    print(f"Erro médio absoluto em Sw (analítica x numérica): " + " | ".join(f"{e:.3e}" for e in erros))

