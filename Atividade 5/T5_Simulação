# 7. COMPARAÇÃO COM O LIVRO DO ROSA — Exemplo 14.8 (Corey, mu_w = 0,5 cP, mu_o = 5 cP, Swi = 0,25, Sor = 0,20)
#    Referência do livro (Fig. 14.64): saturação média atrás da frente = 0,55 / 0,64 / 0,72 (casos 1 / 2 / 3)

def comparar_rosa():
    casos = [("Caso 1 (krw0=0,4; nw=2)", 0.4, 2.0, 0.55), ("Caso 2 (krw0=0,4; nw=4)", 0.4, 4.0, 0.64),
             ("Caso 3 (krw0=0,1; nw=4)", 0.1, 4.0, 0.72)]
    G = criar_malha(100, 5, LX_1D, LY_1D)
    perm = np.full((G.ny, G.nx), k_abs)
    Vp_tot = phi * G.Lx * G.Ly * h
    q_inj = Q_ROSA
    uT = q_inj / (G.Ly * h)
    inj = {(i, 0): q_inj / G.ny for i in range(G.ny)}
    prod = {(i, G.nx - 1): (pw, 2.0 * k_abs * G.dy * h / G.dx) for i in range(G.ny)}

    fig_f, ax_f = plt.subplots(figsize=(6.5, 4))
    S_g = np.linspace(0.0, 1.0, 400)
    print("\n--- COMPARAÇÃO COM O ROSA (Exemplo 14.8) ---")
    print(f"{'Caso':26s}{'Swf':>7s}{'S_med BT':>10s}{'Rosa':>7s}{'PVI_bt (an)':>13s}{'PVI_bt (num)':>14s}{'Np/Np_an':>10s}")

    for cor, (nome, krw0, nw, S_rosa) in zip(["#df65b0", "#980043", "#49006a"], casos):
        rp = dict(rp_corey, krw0=krw0, nw=nw)
        Swf = saturacao_frente(rp)
        S_med = rp['Swi'] + 1.0 / dFw(Swf, rp)                        # Welge: Sw média atrás da frente no breakthrough
        t_bt = G.Lx * phi / (uT * dFw(Swf, rp))                       # [s]  x_f(t_bt) = L
        pvi_bt = q_inj * t_bt / Vp_tot
        t_salvos = [0.5 * t_bt, 0.9 * t_bt]
        sim = simular_cenario(nome, G, perm, rp, 1.3 * t_bt, t_salvos, inj, prod)

        # Perfis do Rosa separados (1 gráfico por caso)
        fig_p, ax = plt.subplots(figsize=(6.5, 4))
        for t_d, ls in zip(sim["campos_S"], ["--", "-"]):
            S_an, _, _ = solucao_buckley_leverett(G.x_c, t_d * DIA, uT, rp)
            ax.plot(G.x_c, S_an, ls, color="#ae017e", linewidth=1.8, label=f"Analítica (t = {t_d:.0f} d)")
            ax.plot(G.x_c, sim["campos_S"][t_d][G.ny // 2, :], "o", color=cor, markersize=3, label=f"Numérica (t = {t_d:.0f} d)")
        ax.set_title(f"Rosa (Ex. 14.8) - {nome}", fontsize=11)
        ax.set_xlabel("X [m]")
        ax.set_ylabel("Saturação de água Sw")
        ax.grid(True, linestyle="--", alpha=0.5)
        ax.legend(fontsize=8)
        plt.tight_layout()
        salvar_e_fechar()

        ax_f.plot(S_g, Fw(S_g, rp), color=cor, linewidth=2, label=f"{nome}")
        ax_f.plot(Swf, Fw(Swf, rp), color="#980043", marker="o", linestyle="None", markersize=5)

        wc = sim["q_w"] / np.maximum(sim["q_w"] + sim["q_o"], 1e-30)
        pvi_num = q_inj * sim["tempo"][np.argmax(wc > 0.01)] * DIA / Vp_tot
        Np_an = Vp_tot * (S_med - rp['Swi'])
        Np_num = np.interp(t_bt / DIA, sim["tempo"], sim["Np"])
        print(f"{nome:26s}{Swf:7.3f}{S_med:10.3f}{S_rosa:7.2f}{pvi_bt:13.3f}{pvi_num:14.3f}{Np_num / Np_an:10.3f}")

    plt.figure(fig_f.number)
    ax_f.set_xlabel("Sw")
    ax_f.set_ylabel("Fluxo fracionário Fw")
    ax_f.set_title("Rosa (Ex. 14.8): Fluxo fracionário e frente de choque", fontsize=11)
    ax_f.grid(True, linestyle="--", alpha=0.5)
    ax_f.legend(fontsize=8)
    plt.tight_layout()
    salvar_e_fechar()

comparar_rosa()

