# 1. PARÂMETROS GERAIS (meio homogêneo, SI)  -- nomenclatura das Aulas 11, 15, 17, 18 e 19

BAR, DIA = 1.0e5, 86400.0
h, phi = 8.5, 0.25                  # Espessura [m] e porosidade (Rosa, Ex. 14.7)
k_abs = 1000.0 * 9.869233e-16       # Permeabilidade homogênea: 1000 mD -> m² (hipótese: o Rosa não fornece k)
ct = 1.0e-10                        # Compressibilidade total [Pa^-1] (pequena: aproxima ∇·v_T = 0 da Aula 18)
p_ini = 100.0 * BAR                 # Pressão inicial uniforme
pw = 100.0 * BAR                    # Pressão de fundo de poço (p_w) / pressão de saída
