# Permeabilidades relativas (Aula 19):  S*_w = (Sw - Swi) / (1 - Sor - Swi)
#   Pistão (idealizado): krw = S*_w, kro = 1 - S*_w, mu_w = mu_o  -> F_w linear, frente em degrau
#   Corey (Buckley-Leverett): krw = krw0 (S*_w)^nw, kro = kro0 (1 - S*_w)^no
rp_pistao = dict(Swi=0.25, Sor=0.20, krw0=1.0, kro0=1.0, nw=1.0, no=1.0, mu_w=0.5e-3, mu_o=0.5e-3)
# Rosa, Ex. 14.8 (caso 1): mu_w = 0,5 cP, mu_o = 5 cP, Swi = 0,25, Sor = 0,20, kro0 = 0,7 (no = 2), krw0 = 0,4 (nw = 2)
rp_corey = dict(Swi=0.25, Sor=0.20, krw0=0.4, kro0=0.7, nw=2.0, no=2.0, mu_w=0.5e-3, mu_o=5.0e-3)

def criar_malha(nx, ny, Lx, Ly):
    """Malha de volumes finitos centrados. Matrizes (ny, nx): índice [i, j] = (linha em y, coluna em x)."""
    dx, dy = Lx / nx, Ly / ny
    dV = h * dx * dy                                  # ΔV_P = h Δx Δy
    return SimpleNamespace(
        nx=nx, ny=ny, N=nx * ny, Lx=Lx, Ly=Ly, dx=dx, dy=dy, dV=dV, Vp=phi * dV,
        x_c=(np.arange(nx) + 0.5) * dx, y_c=(np.arange(ny) + 0.5) * dy
    )

# 2. PERMEABILIDADE RELATIVA, FLUXO FRACIONÁRIO E SOLUÇÕES ANALÍTICAS (Aula 19)

def kr(Sw, rp):
    Sn = np.clip((Sw - rp['Swi']) / (1.0 - rp['Sor'] - rp['Swi']), 0.0, 1.0)     # S*_w
    return rp['krw0'] * Sn ** rp['nw'], rp['kro0'] * (1.0 - Sn) ** rp['no']

def Fw(Sw, rp):
    """F_w = (krw/mu_w) / (krw/mu_w + kro/mu_o)"""
    krw, kro = kr(Sw, rp)
    lamW, lamO = krw / rp['mu_w'], kro / rp['mu_o']
    return lamW / (lamW + lamO)

def dFw(Sw, rp, dS=1.0e-5):
    """F'_w por derivada numérica central (h = 1e-5, Aula 19)."""
    return (Fw(Sw + dS, rp) - Fw(Sw - dS, rp)) / (2.0 * dS)

def dFw_maximo(rp):
    S = np.linspace(rp['Swi'], 1.0 - rp['Sor'], 2001)
    return np.max(dFw(S, rp))

def saturacao_frente(rp):
    """Saturação da frente S_wf: raiz de g(Sw) = F'_w(Sw) - [F_w(Sw) - F_w(Swi)] / (Sw - Swi) (brentq, Aula 19)."""
    Swi, Sinj = rp['Swi'], 1.0 - rp['Sor']
    g = lambda S: dFw(S, rp) - (Fw(S, rp) - Fw(Swi, rp)) / (S - Swi)
    return brentq(g, Swi + 1.0e-3, Sinj - 1.0e-3)

def solucao_pistao(x, t, uT, rp):
    """Deslocamento pistão: Sw = 1 - Sor para x < x_f(t) e Swi para x > x_f(t); x_f = uT t / (phi (1 - Sor - Swi))."""
    xf = uT * t / (phi * (1.0 - rp['Sor'] - rp['Swi']))
    return np.where(x < xf, 1.0 - rp['Sor'], rp['Swi']), 1.0 - rp['Sor'], xf

def solucao_buckley_leverett(x, t, uT, rp):
    """Buckley-Leverett: Sw = S_inj (x < v_c(S_inj) t); F'_w^-1(phi x / (uT t)) (região de rarefação); Swi (x >= x_f).
    x_f = uT t F'_w(S_wf) / phi.  Retorna Sw(x, t), S_wf e x_f(t)."""
    Swi, Sinj = rp['Swi'], 1.0 - rp['Sor']
    Swf = saturacao_frente(rp)
    xf = uT * t / phi * dFw(Swf, rp)

    S_r = np.linspace(Swf, Sinj, 4001)                # ramo da rarefação: F'_w decrescente com Sw
    d_r = dFw(S_r, rp)
    Sw = np.interp(phi * x / (uT * t), d_r[::-1], S_r[::-1])      # inversa de F'_w
    return np.where(x >= xf, Swi, Sw), Swf, xf

# 3. MÉTODO IMPES (Aulas 17 e 18): pressão implícita + saturação explícita

def passo_impes(G, perm, rp, p0, Sw0, dt, inj, prod, dFw_max):
    """Um passo IMPES. p0, Sw0: campos (ny, nx) do nível de tempo anterior.
    inj  = {(i, j): q_inj [m³/s]}
    prod = {(i, j): (p_w [Pa], WI [m³])}   (WI inclui k; mobilidade λ_T multiplica)"""
    nx, ny, dx, dy = G.nx, G.ny, G.dx, G.dy
    krw, kro = kr(Sw0, rp)
    lamW, lamO = krw / rp['mu_w'], kro / rp['mu_o']
    lamT = lamW + lamO                                # λ_T = λ_w + λ_o
    FwP = lamW / lamT                                 # F_w do bloco

    # Coeficientes A_E = A_W e A_N = A_S: (k/Δ²) λ_T com upwind (compara pressões) e k na face = média harmônica
    kx = 2.0 * perm[:, :-1] * perm[:, 1:] / (perm[:, :-1] + perm[:, 1:])
    ky = 2.0 * perm[:-1, :] * perm[1:, :] / (perm[:-1, :] + perm[1:, :])
    Tx = kx * dy * h / dx * np.where(p0[:, :-1] >= p0[:, 1:], lamT[:, :-1], lamT[:, 1:])
    Ty = ky * dx * h / dy * np.where(p0[:-1, :] >= p0[1:, :], lamT[:-1, :], lamT[1:, :])

    # Equação da pressão:  A_P p_P - A_E p_E - A_W p_W - A_N p_N - A_S p_S = b_P
    C_dt = G.dV * phi * ct / dt
    AP = np.full((ny, nx), C_dt)
    AP[:, :-1] += Tx
    AP[:, 1:] += Tx
    AP[:-1, :] += Ty
    AP[1:, :] += Ty
    b = C_dt * p0

    for (i, j), (p_w, WI) in prod.items():            # Produtor (Aulas 11 e 17): q_prod = λ_T WI (p_P - p_w) -> A_P e b
        AP[i, j] += WI * lamT[i, j]
        b[i, j] += WI * lamT[i, j] * p_w
    for (i, j), q in inj.items():                     # Injetor: vazão prescrita -> apenas em b
        b[i, j] += q

    idx = np.arange(G.N).reshape(ny, nx)
    r = np.concatenate([idx[:, :-1].ravel(), idx[:, 1:].ravel(), idx[:-1, :].ravel(), idx[1:, :].ravel(), idx.ravel()])
    c = np.concatenate([idx[:, 1:].ravel(), idx[:, :-1].ravel(), idx[1:, :].ravel(), idx[:-1, :].ravel(), idx.ravel()])
    v = np.concatenate([-Tx.ravel(), -Tx.ravel(), -Ty.ravel(), -Ty.ravel(), AP.ravel()])
    A = sp.coo_matrix((v, (r, c)), shape=(G.N, G.N)).tocsr()

    p = spla.spsolve(A, b.ravel()).reshape(ny, nx)

    # Vazões totais q_T nas faces (positivo: W->E e S->N) e vazão de água F_w q_T com F_w a montante
    qx = Tx * (p[:, :-1] - p[:, 1:])
    qy = Ty * (p[:-1, :] - p[1:, :])
    Fwx = np.where(qx >= 0.0, FwP[:, :-1], FwP[:, 1:])
    Fwy = np.where(qy >= 0.0, FwP[:-1, :], FwP[1:, :])

    saida_w = np.zeros((ny, nx))    # saldo líquido de água que sai de cada bloco [m³/s]
    saida_T = np.zeros((ny, nx))    # soma das vazões totais que saem do bloco (para o CFL)
    saida_w[:, :-1] += Fwx * qx
    saida_w[:, 1:] -= Fwx * qx
    saida_w[:-1, :] += Fwy * qy
    saida_w[1:, :] -= Fwy * qy
    saida_T[:, :-1] += np.maximum(qx, 0.0)
    saida_T[:, 1:] += np.maximum(-qx, 0.0)
    saida_T[:-1, :] += np.maximum(qy, 0.0)
    saida_T[1:, :] += np.maximum(-qy, 0.0)

    qT_prod, qw_prod = 0.0, 0.0
    for (i, j), (p_w, WI) in prod.items():            # q_w = F_w q_prod (Aula 17)
        qT = WI * lamT[i, j] * (p[i, j] - p_w)
        saida_w[i, j] += FwP[i, j] * qT
        saida_T[i, j] += max(qT, 0.0)
        qT_prod += qT
        qw_prod += FwP[i, j] * qT
    for (i, j), q in inj.items():                     # q_T = q_w = q_inj (só água é injetada)
        saida_w[i, j] -= q

    Sw = Sw0 - dt / G.Vp * saida_w                    # Saturação explícita (Aula 18)
    smax = saida_T.max()
    CFL = dt * smax * dFw_max / G.Vp                  # Aula 17: Δt <= phi ΔV_P / (q_T,P F'_w,max)
    return p, Sw, qT_prod, qw_prod, CFL, smax

def simular_cenario(nome, G, perm, rp, tempo_total, t_salvos, inj, prod, cfl_alvo=0.5):
    dFw_max = dFw_maximo(rp)
    p = np.full((G.ny, G.nx), p_ini)
    Sw = np.full((G.ny, G.nx), rp['Swi'])
    q_inj_tot = sum(inj.values())

    t, dt_ant, dt_cfl = 0.0, 1.0e-4 * tempo_total, np.inf
    dt_max, dt_min = tempo_total / 200.0, 1.0e-9 * tempo_total
    t_alvos = sorted(set(t_salvos) | {tempo_total})
    tempo, q_o, q_w, dts = [0.0], [0.0], [0.0], [0.0]
    campos_P, campos_S = {}, {}

    t_exec = time.time()
    while t < tempo_total * (1.0 - 1e-12):
        prox = next(ta for ta in t_alvos if ta > t * (1.0 + 1e-12))
        dt_livre = min(dt_max, dt_cfl, 1.5 * dt_ant)
        dt = dt_livre
        fim = (prox - t) <= dt * (1.0 + 1e-9)
        if fim:
            dt = prox - t

        while True:     # refaz o passo se o CFL real violar a estabilidade da saturação
            p_n, Sw_n, qT_prod, qw_prod, CFL, smax = passo_impes(G, perm, rp, p, Sw, dt, inj, prod, dFw_max)
            if CFL <= 1.0 or dt <= dt_min:
                break
            dt *= 0.5
            dt_livre = min(dt_livre, dt)
            fim = False

        p, Sw = p_n, Sw_n
        t = prox if fim else t + dt
        dt_ant = dt_livre
        dt_cfl = cfl_alvo * G.Vp / (smax * dFw_max) if smax > 0 else np.inf

        tempo.append(t)
        dts.append(dt)
        q_w.append(qw_prod)
        q_o.append(qT_prod - qw_prod)
        if fim and prox in t_salvos:
            campos_P[t / DIA] = p.copy()
            campos_S[t / DIA] = Sw.copy()

    tempo, dts = np.array(tempo), np.array(dts)
    q_o, q_w = np.array(q_o), np.array(q_w)
    print(f"[{nome}] Simulação concluída em {time.time() - t_exec:.2f} s ({len(tempo) - 1} passos).")

    return {
        "campos_P": campos_P, "campos_S": campos_S, "P_final": p, "S_final": Sw,
        "tempo": tempo / DIA, "q_o": q_o, "q_w": q_w, "q_inj": q_inj_tot,
        "Np": np.cumsum(q_o * dts), "Wp": np.cumsum(q_w * dts), "Winj": q_inj_tot * tempo_total,
        "dts": dts
    }

def validar_simulacao(nome, G, sim, rp):
    erros = []
    P, S = sim["P_final"], sim["S_final"]
    if not (np.all(np.isfinite(P)) and np.all(np.isfinite(S))):
        erros.append("Pressões ou saturações NaN/infinitas.")
    if S.min() < rp['Swi'] - 1e-3 or S.max() > 1.0 - rp['Sor'] + 1e-3:
        erros.append(f"Sw fora do intervalo físico [{S.min():.4f}, {S.max():.4f}].")
    if P.min() < pw - 1e-3 * BAR:
        erros.append(f"Pressão mínima ({P.min()/BAR:.2f} bar) menor que p_w.")

    # Balanço de água: acúmulo = injetado - produzido
    dW = np.sum(G.Vp * (S - rp['Swi']))
    W_bal = sim["Winj"] - sim["Wp"][-1]
    erro_w = abs(dW - W_bal) / max(sim["Winj"], 1e-12)

    # Balanço volumétrico total (compressibilidade): acúmulo = injetado - produzido
    dV_acum = np.sum(G.dV * phi * ct * (P - p_ini))
    V_bal = sim["Winj"] - (sim["Np"][-1] + sim["Wp"][-1])
    erro_v = abs(dV_acum - V_bal) / max(sim["Winj"], 1e-12)

    print(f"\n--- RELATÓRIO DE VALIDAÇÃO: {nome} ---")
    print(f"Pmin: {P.min()/BAR:.2f} bar | Pmax: {P.max()/BAR:.2f} bar | Sw: [{S.min():.4f}, {S.max():.4f}]")
    print(f"Injetado: {sim['Winj']:.4f} m³ | Np: {sim['Np'][-1]:.4f} m³ | Wp: {sim['Wp'][-1]:.4f} m³")
    print(f"Erro relativo do balanço de água:     {erro_w:.3e}")
    print(f"Erro relativo do balanço volumétrico: {erro_v:.3e}")

    if erro_w > 1e-8 or erro_v > 1e-6 or erros:
        print("STATUS: VERIFICAR")
        for e in erros:
            print(f"  -> {e}")
        return False
    print("STATUS: PASSOU (Fisicamente coerente e conservação estrita).")
    return True

