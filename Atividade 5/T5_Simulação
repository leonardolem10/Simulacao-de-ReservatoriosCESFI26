# 5. CASOS 1D (pistão e Buckley-Leverett): injeção na fronteira oeste, pressão de saída na fronteira leste (Aula 19)

LX_1D, LY_1D = 800.0, 400.0            # Rosa, Ex. 14.7: comprimento até o produtor mais próximo e largura [m]
Q_ROSA = 150.0 / DIA                  # Rosa, Ex. 14.7: Q_inj = 150 m³/d (Bw = 1, fluidos incompressíveis)

def rodar_caso_1d(nome, rp, solucao, q_inj, pvi_total, pvi_salvos):
    G = criar_malha(100, 5, LX_1D, LY_1D)
    perm = np.full((G.ny, G.nx), k_abs)
    Vp_tot = phi * G.Lx * G.Ly * h
    uT = q_inj / (G.Ly * h)                                                          # u_T = q_T / A
    t_total = pvi_total * Vp_tot / q_inj
    t_salvos = [p * Vp_tot / q_inj for p in pvi_salvos]

    inj = {(i, 0): q_inj / G.ny for i in range(G.ny)}                               # entrada: coluna oeste
    WI_face = 2.0 * k_abs * G.dy * h / G.dx                                          # Dirichlet na face (Aula 14): 2k/Δx
    prod = {(i, G.nx - 1): (pw, WI_face) for i in range(G.ny)}                       # saída: coluna leste

    sim = simular_cenario(nome, G, perm, rp, t_total, t_salvos, inj, prod)

    _, Swf, xf = solucao(G.x_c, t_total, uT, rp)
    t_bt = G.Lx * t_total / xf / DIA                                                 # x_f(t_bt) = L
    print(f"[{nome}] S_wf = {Swf:.4f} | PVI de breakthrough analítico = {t_bt * DIA * q_inj / Vp_tot:.3f} | t_bt = {t_bt:.2f} dias")

    p_all = [c / BAR for c in sim["campos_P"].values()]
    plotar_campos({t: c / BAR for t, c in sim["campos_P"].items()}, G, f"{nome}: Campo de Pressão",
                  "Pressão [bar]", "PuRd", min(c.min() for c in p_all), max(c.max() for c in p_all))
    plotar_campos(sim["campos_S"], G, f"{nome}: Campo de Saturação de Água",
                  "Saturação de água Sw", "PuRd", rp['Swi'], 1.0 - rp['Sor'])
    plotar_perfis(G, sim, rp, uT, solucao, f"{nome}: Saturação Sw ao longo de X")
    plotar_desempenho(sim, f"{nome}: Vazão e produção acumulada", t_bt=t_bt)
    validar_simulacao(nome, G, sim, rp)
    return sim

