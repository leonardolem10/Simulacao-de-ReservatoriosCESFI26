def simular_caso(dx_in, dt_in, t_final=2.0, checar_estabilidade=False):
    Nx_in = int(L / dx_in) + 2
    Nt_in = int(t_final / dt_in) + 1
    rx_in = dt_in / (dx_in ** 2)

    if checar_estabilidade and (rx_in * eta > 0.25):
        raise ValueError("Condição de estabilidade não satisfeita!")

    x_grid = np.zeros(Nx_in)
    x_grid[0] = 0.0
    x_grid[1] = dx_in / 2.0
    for i in range(2, Nx_in - 1):
        x_grid[i] = x_grid[i - 1] + dx_in
    x_grid[-1] = L

    A_mat = np.zeros((Nx_in - 2, Nx_in - 2))
    for i in range(Nx_in - 2):
        if i == 0:
            A_mat[i, i] = 1.0 + rx_in * eta
            A_mat[i, i + 1] = -rx_in * eta
        elif i == Nx_in - 3:
            A_mat[i, i - 1] = -(4.0 / 3.0) * rx_in * eta
            A_mat[i, i] = 1.0 + 4.0 * rx_in * eta
        else:
            A_mat[i, i - 1] = -rx_in * eta
            A_mat[i, i] = 1.0 + 2.0 * rx_in * eta
            A_mat[i, i + 1] = -rx_in * eta

    F_vec = np.zeros(Nx_in - 2)
    F_vec[0] = eta * rx_in * qw * (119.6 * mi * dx_in) / (k * A_sec)
    F_vec[-1] = (8.0 / 3.0) * rx_in * eta * Pe

    p_exp_arr = np.ones((Nt_in, Nx_in)) * Pe
    p_gs_arr = np.ones((Nt_in, Nx_in)) * Pe
    p_dir_arr = np.ones((Nt_in, Nx_in)) * Pe

    for n in range(0, Nt_in - 1):
        # Explicito
        p_exp_arr[n + 1, 0] = p_exp_arr[n, 1] + ((119.6 * qw * mi * dx_in) / (2.0 * k * A_sec))
        p_exp_arr[n + 1, 1] = eta * rx_in * p_exp_arr[n, 2] + (1.0 - eta * rx_in) * p_exp_arr[n, 1] + F_vec[0]
        for i in range(2, Nx_in - 2):
            p_exp_arr[n + 1, i] = rx_in * eta * p_exp_arr[n, i - 1] + (1.0 - 2.0 * rx_in * eta) * p_exp_arr[n, i] + rx_in * eta * p_exp_arr[n, i + 1]
        p_exp_arr[n + 1, -2] = (4.0 / 3.0) * rx_in * eta * p_exp_arr[n, -3] + (1.0 - 4.0 * rx_in * eta) * p_exp_arr[n, -2] + F_vec[-1]
        p_exp_arr[n + 1, -1] = Pe

        # Implicito Gauss-Seidel
        b_gs = p_gs_arr[n, 1:-1] + F_vec
        p_new_gs, _ = Gauss_Seidel(A_mat, b_gs, p_gs_arr[n, 1:-1], tol=1e-8)
        p_gs_arr[n + 1, 1:-1] = p_new_gs
        p_gs_arr[n + 1, -1] = Pe
        p_gs_arr[n + 1, 0] = p_new_gs[0] + ((119.6 * qw * mi * dx_in) / (2.0 * k * A_sec))

        # Implicito Solver Direto
        b_dir = p_dir_arr[n, 1:-1] + F_vec
        p_new_dir = np.linalg.solve(A_mat, b_dir)
        p_dir_arr[n + 1, 1:-1] = p_new_dir
        p_dir_arr[n + 1, -1] = Pe
        p_dir_arr[n + 1, 0] = p_new_dir[0] + ((119.6 * qw * mi * dx_in) / (2.0 * k * A_sec))

    return x_grid, p_exp_arr[-1], p_gs_arr[-1], p_dir_arr[-1]

